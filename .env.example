# Local development configuration
# For deployment, these are set via Terraform / the deploy command.
#
# Copy to `.env` and fill in the placeholders:
#     cp .env.example .env
# `.env` is git-ignored and MUST NOT be committed.

# Vertex AI Configuration (default)
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global
GOOGLE_API_USE_CLIENT_CERTIFICATE=false

# Optional Gemini API key fallback
# Alternatively, for Gemini API via Google AI Studio, comment out the
# Vertex AI block above and uncomment the line below.
# GEMINI_API_KEY=your-api-key-here

# --- Mock Enterprise Services (MCP) ---
# Source: env.md. Token must be sent via the custom X-MCP-Token header
# because Google Frontend intercepts standard Authorization headers.
MCP_BASE_URL=https://your-mock-saas-host.example.com
MCP_TOKEN=your-mcp-token-here
MCP_TIMEOUT_SECONDS=45

# --- Challenge project (from env.md) ---
ELEVATE_PROJECT_ID=your-elevate-project-id
ELEVATE_PROJECT_NUMBER=your-elevate-project-number
